          <mxGeometry x="20" y="40" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rs_dec_box" value="解码器 StegoDecoder" style="swimlane;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;startSize=23;" parent="rsgan_container" vertex="1">
