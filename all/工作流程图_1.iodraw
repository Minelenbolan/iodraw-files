        </mxCell>

        <mxCell id="select_extract_method" value="读取隐写方式&lt;br/&gt;method_combo" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="group_extract">
          <mxGeometry x="110" y="140" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="exec_ex_rsgan" value="rs_stego.decode()&lt;br/&gt;stego → 4层CNN&lt;br/&gt;→ 恢复文本" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_extract">
