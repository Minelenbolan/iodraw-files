        </mxCell>

        <mxCell id="exec_ex_dwt" value="extract_dwt_qim()&lt;br/&gt;读取QIM量化值&lt;br/&gt;→ 恢复文本/图" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_extract">
          <mxGeometry x="115" y="340" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="exec_ex_hidden" value="decoder()&lt;br/&gt;stego → 7层卷积网络&lt;br/&gt;→ recovered.png" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_extract">
          <mxGeometry x="210" y="260" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="calc_ex_metrics" value="数据提取指标计算&lt;br/&gt;calc_text_metrics() / image_metrics()&lt;br/&gt;Accuracy / BER / PSNR" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_extract">
          <mxGeometry x="70" y="470" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="update_ex_ui" value="更新界面显示&lt;br/&gt;① 提取文本/图像显示&lt;br/&gt;② 指标面板显示 BER/Acc等" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f5fe;" vertex="1" parent="group_extract">
          <mxGeometry x="70" y="560" width="220" height="60" as="geometry" />
