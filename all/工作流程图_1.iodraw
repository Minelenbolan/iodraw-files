        </mxCell>

        <mxCell id="calc_embed_metrics" value="计算嵌入质量指标&lt;br/&gt;calc_image_metrics()&lt;br/&gt;PSNR / SSIM" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_embed">
