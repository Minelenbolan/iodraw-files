          <mxGeometry x="354" y="170" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="step1" target="decide_op">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ 嵌入流程左半部分 ============ -->
        <mxCell id="group_embed" value="嵌入流程 on_embed()" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=#f0f3ff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="360" height="680" as="geometry" />
        </mxCell>

        <mxCell id="check_cover" value="cover_path&lt;br/&gt;是否为空?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="group_embed">
          <mxGeometry x="115" y="40" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="alert_embed" value="弹出警告：&lt;br/&gt;请先选择载体图" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="group_embed">
          <mxGeometry x="250" y="45" width="100" height="50" as="geometry" />
        </mxCell>

        <mxCell id="select_embed_method" value="读取隐写方式&lt;br/&gt;method_combo" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="group_embed">
          <mxGeometry x="110" y="140" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="embed_lsb" value="LSB" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="group_embed">
          <mxGeometry x="50" y="155" width="40" height="30" as="geometry" />
        </mxCell>
        <mxCell id="embed_dwt" value="DWT(QIM)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="group_embed">
          <mxGeometry x="100" y="210" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="embed_hidden" value="HiDDeN" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="group_embed">
          <mxGeometry x="200" y="210" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="embed_rsgan" value="RS-GAN" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="group_embed">
          <mxGeometry x="270" y="155" width="70" height="30" as="geometry" />
        </mxCell>

        <mxCell id="exec_lsb" value="LSBstego.embed()&lt;br/&gt;cover + text → stego.png" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_embed">
          <mxGeometry x="10" y="260" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="exec_dwt" value="embed_dwt_qim()&lt;br/&gt;DWT变换→QIM量化嵌入" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_embed">
          <mxGeometry x="10" y="330" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="exec_hidden" value="encoder()&lt;br/&gt;Cover + Secret灰度图&lt;br/&gt;双分支编码 → stego.png" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_embed">
          <mxGeometry x="200" y="260" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="exec_rsgan" value="rs_stego.encode()&lt;br/&gt;Generator残差生成&lt;br/&gt;→ stego.png" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="group_embed">
