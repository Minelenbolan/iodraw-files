        </mxCell>

        <mxCell id="update_embed_ui" value="更新界面显示&lt;br/&gt;① 含密图预览 → stego_box&lt;br/&gt;② 指标面板 → PSNR / SSIM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f5fe;" vertex="1" parent="group_embed">
          <mxGeometry x="85" y="560" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ============ 提取流程右半部分 ============ -->
        <mxCell id="group_extract" value="提取流程 on_extract()" style="swimlane;whiteSpace=wrap;html=1;startSize=23;fillColor=#f9f7ed;strokeColor=#ae9043;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="360" height="680" as="geometry" />
        </mxCell>

        <mxCell id="check_stego" value="stego_path&lt;br/&gt;是否为空?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="group_extract">
